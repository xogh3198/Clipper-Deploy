# Copy to clipper-docker.local.env to override. No Docker context is forced.
PROJECT=taeho-clipper
GPU=2
GPU_TYPE=v100
PYTHON_IMAGE=python:3.11-slim-bookworm
TORCH_VERSION=2.11.0+cu126
TORCHVISION_VERSION=0.26.0+cu126
LIB_BASE_IMAGE=taeho-clipper/lib_base:local-v1
BUILD_LIB_BASE=1
PULL_LIB_BASE=0
BASE_BUILD_JOBS=2
QUERY_IMAGE=taeho-clipper-query:0.1.0
MANAGEMENT_IMAGE=taeho-clipper-management:0.1.0
WORKER_IMAGE=taeho-clipper-worker:0.2.0
REDIS_IMAGE=redis:6.2-alpine
MODEL_NAME=resnet-50
MODEL_VERSION=1
MODEL_ID=microsoft/resnet-50
MODEL_REVISION=34c2154c194f829b11125337b98c8f5f9965ff19
APPLICATION=imagenet
SLO_MS=200
BATCH_SIZE=-1
CPU_THREADS=2
WARMUP_QUERIES=10
QUERY_THREADS=16
QUERY_PORT=21337
MANAGEMENT_PORT=21338
STATS_PORT=21339
MODEL_DIR=data/clipper/models
RESULT_DIR=data/clipper/v3/results
INPUT_IMAGE=inputs/test-dog.jpg
ALLOW_GPU_SHARING=0
